# files
####

# ignore test coverage files
cover.*

# ignore coverage generated report files
coverage.xml

# ignore compiled python scripts
*.py[cod]

# ignore databases
*.db

# ignore log files
*.log

TODO*

# ignore all scratch related files and folders
scratch*

# ignore sqlite memory files
:memory:

# ignore all dot files
.*

# folders
####

# ignore all dot folders
.*/

# temporary folders
temp/

# temporary folders
tmp/

# ignore pr worktree folders
pr/*/

# ignore html coverage folder
htmlcov/

# ignore github instructions folders
instructions/

# ignore egg info folders
*.egg-info/

# ignore python cache folders
__pycache__/

# overrides (excludes)
####

# overrides ignore for all dot folders except .github
!.github/

# overrides ignore for test data coverage folder from being ignored (nocrap)
!internal/coverage/

# overrides ignore for .gitignore files
!.gitignore

# overrides ignore for pre-commit-config.yaml files
!.pre-commit-config.yaml

# overrides ignore for circleci folder
!.circleci/