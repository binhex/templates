# files
####

# ignore test coverage files
cover.*

# ignore coverage generated report files
coverage.xml

# ignore compiled python scripts
*.py[cod]

# ignore databases
*.db

# ignore log files
*.log

TODO*

# ignore all scratch related files and folders
scratch*

# ignore sqlite memory files
:memory:

# ignore all dot files
.*

# folders
####

# ignore all dot folders
.*/

# temporary folders
temp/

# temporary folders
tmp/

# ignore build folders
target/

# ignore pr worktree folders
pr/*/

# ignore html coverage folder
htmlcov/

# ignore github instructions folders
instructions/

# ignore egg info folders
*.egg-info/

# ignore python cache folders
__pycache__/

# credentials and secret material must never be committed
*.env
.env*
*.token
*.pat
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/
secrets.env

# overrides (excludes)
####

# overrides ignore for all dot folders except these files
!.gitignore
!.pre-commit-config.yaml
!.gitleaks.toml
!.env.example
!.env.sample
!.env.template

# overrides ignore for all dot folders except these folders
!.git/
!.github/
!internal/coverage/
!.circleci/
!.plugin/
